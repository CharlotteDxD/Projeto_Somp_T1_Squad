# Copiar para /etc/sompo-predict.env  (chmod 600, dono root)
#
#   sudo cp deploy/sompo-api.env.exemplo /etc/sompo-predict.env
#   sudo chmod 600 /etc/sompo-predict.env
#   sudo nano /etc/sompo-predict.env
#
# Este arquivo NUNCA vai para o repositorio.

# Porta de publicacao. 80 evita bloqueio de porta alta em redes de campo.
PORT=80

# Exigir assinatura nas leituras recebidas. Manter 1 em producao.
SOMPO_EXIGIR_HMAC=1

# Uma chave por dispositivo, minimo 32 bytes.
# O nome da variavel deriva do identificador: T1-CART-01 -> T1_CART_01
# Gerar com: openssl rand -hex 32
SOMPO_HMAC_T1_CART_01=troque-esta-chave-por-32-bytes-aleatorios

# Onde as leituras sao persistidas
SOMPO_TELEMETRIA_CSV=/opt/sompo-predict/telemetria_ingerida.csv

# Base de apolices usada para o score de perfil
SOMPO_BASE_PATH=/opt/sompo-predict/base_sompo_limpa.csv

SOMPO_LOG_LEVEL=INFO
